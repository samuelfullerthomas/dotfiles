brew "go"

# Cloud & infra
brew "awscli"

# Networking & services
brew "mkcert"

# CLI utilities
brew "rename"
brew "grep"
brew "blueutil"
brew "sleepwatcher", restart_service: :changed
brew "pinentry-mac"

# Media
brew "ffmpeg"
brew "imagemagick"
brew "pngquant"
brew "yt-dlp"

