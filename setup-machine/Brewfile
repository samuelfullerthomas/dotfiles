# Installed with `make apps`, which passes HOMEBREW_MACHINE=work|personal.
# Anything installed but not listed here shows up in `make doctor` and `make check`.
machine = ENV["HOMEBREW_MACHINE"] || (File.read(File.expand_path("~/setup-machine/.machine")).strip rescue nil)
# Homebrew only passes HOMEBREW_* variables through, hence HOMEBREW_MACHINE.
raise "Set HOMEBREW_MACHINE=work|personal (make and doctor.sh do this)" unless %w[work personal].include?(machine)
work = machine == "work"

# Core dev tools
brew "git"
