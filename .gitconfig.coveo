[user]
	name = Sam Thomas
	email = sthomas@coveo.com
	signingkey = BC0D1F8B5143DF97
[core]
	excludesfile = ~/.gitignore_global
[pager]
	branch = false
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[commit]
	gpgsign = true
[push]
	default = current
[pull]
	rebase = false
